[Desktop Entry]
Type=Application
Name=Study Reader
Comment=PDF/EPUB reader with per-snippet Claude chats
Exec=@PIXI@ run --manifest-path @REPO@/pixi.toml app %f
Icon=study-reader
Terminal=false
Categories=Office;Viewer;Education;
MimeType=application/pdf;application/epub+zip;
StartupWMClass=study-reader
